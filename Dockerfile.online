# 在线构建镜像（联网环境用，如群晖 docker compose build）
#
# 与生产离线 Dockerfile 的差异：
# - 不依赖 .wheels/ 离线 wheel 包，直接从 PyPI 安装 requirements.txt（可用
#   PIP_INDEX_URL 换源加速）；Claude Code CLI 走可选的 claude-local/ 离线
#   携带（版本与 tools/claude-bin.json 对齐），目录缺失时跳过——仅 Claude
#   Code Agent 裁判引擎不可用，其余功能完整
# - 前端 dist 在 node 阶段现构建（离线版由构建机预构建后 COPY）
#
# 构建：docker build -f Dockerfile.online -t ai-evo:online .
# 换源：默认清华 PyPI / npmmirror，可用构建参数覆盖（--build-arg）
FROM node:24-slim AS frontend-builder

ARG NPM_REGISTRY=https://registry.npmmirror.com
WORKDIR /build
# 钉 pnpm 11：frontend/pnpm-workspace.yaml 的 allowBuilds 是 pnpm 11 语法
# （pnpm 9 会把它当空 workspace 报 packages field missing），与开发机 11.7 一致
RUN corepack enable && corepack prepare pnpm@11.7.0 --activate
ENV npm_config_registry=${NPM_REGISTRY} \
    npm_config_verify_deps_before_run=false

# pnpm-workspace.yaml 含 allowBuilds 声明（允许 esbuild/vue-demi 跳过构建脚本），
# 必须与 lockfile 一起在 install 前就位，否则 pnpm 11 以 ERR_PNPM_IGNORED_BUILDS 退出
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY frontend/ ./
RUN pnpm build

FROM python:3.12-slim

WORKDIR /app

# ARCH-0-1：非 root 运行用户（uid/gid 10002，与离线 Dockerfile 完全一致，设计 D3
# 钉死；与 script-runner 沙箱用户 10001 分离）。安装/构建步骤仍以 root 执行。
RUN groupadd -g 10002 app \
    && useradd -m -u 10002 -g 10002 -s /usr/sbin/nologin app

ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_DEFAULT_TIMEOUT=120

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Claude Code CLI（Claude Code Agent 裁判引擎的运行时依赖）：与离线 Dockerfile
# 相同的离线携带方式——claude-local/bin/claude 由构建方从官方发布
# （storage.googleapis.com/claude-code-dist-*/claude-code-releases/<ver>/linux-x64/claude，
# 版本与 tools/claude-bin.json 对齐）预先下载就位，自包含 Bun 二进制，
# 无需 Node.js 运行时；不入 git。
# 通配 COPY：claude-local/ 缺失时为空操作（CI / OSS clone 构建仍可成功）
# ARCH-0-1：落点从 /root/.local 改为 /opt/claude——/root 为 0700，非 root 运行
# 用户读不到也执行不了（与离线 Dockerfile 同一处理）。
COPY claude-local* /opt/claude/
RUN ln -sf /opt/claude/bin/claude /usr/local/bin/claude \
    && if [ -x /opt/claude/bin/claude ]; then /usr/local/bin/claude --version; \
    else echo "[warn] claude-local/ 未提供，镜像不含 Claude Code CLI"; fi

# DeepSeek Harness 裁判引擎无需额外安装：requirements.txt 中的
# deepseek-harness-sdk wheel 自带 linux/amd64 原生运行时（deepseek_harness_runtime）

# 复制应用代码
COPY app/ app/
# executor 小包（纯标准库）：app/core/config.py 顶层 import executor.sandbox_params
# （CONTAINER_RUNTIMES 白名单同源）——主镜像漏 COPY 会让 api/worker 启动即
# ModuleNotFoundError（NAS 冒烟实测缺陷，CI 镜像导入冒烟步防回归）
COPY executor/ executor/
COPY alembic/ alembic/
COPY alembic.ini .

# 前端构建产物（FastAPI 托管）
COPY --from=frontend-builder /build/dist/ frontend/dist/

# 用户使用文档
COPY docs/ docs/

# 入口脚本
COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENV CLAUDE_CODE_PATH=/usr/local/bin/claude

# ARCH-0-1：运行期写面收口（与离线 Dockerfile 同一口径）：/app 代码保持 root
# 属主只读，仅 uploads/logs 写面预建并 chown 10002——命名卷首次创建按此初始化；
# bind 挂载的属主迁移由 compose volume-init 服务 + docker-entrypoint.sh 完成。
RUN mkdir -p /app/uploads /app/logs \
    && chown app:app /app/uploads /app/logs

# ARCH-0-1：非 root 运行（设计 D3）；HOME 钉到 /home/app（compose 侧 tmpfs）
ENV HOME=/home/app
USER app

ENTRYPOINT ["docker-entrypoint.sh"]
