# AI 评测平台「多机扩容」评测机环境变量模板（ARCH-3-1，设计 §3 Phase 3 表 3-1 行）
#
# 使用方法：复制到评测机部署目录下的 .env.scale 并填入真实值：
#   cp .env.scale.example .env.scale && chmod 600 .env.scale
#
# 本文件只跑在「评测机」上（docker-compose.scale.yml：worker-eval + executor
# 成对）。完整拓扑、共享存储边界与部署步骤见 docs/deploy-scale.md；
# 主控机仍用 .env.example / docker-compose.yml，两边互不替代。
#
# 所有命令统一带 --env-file（插值与 env_file 同源，避免读错旁边的 .env）：
#   docker compose --env-file .env.scale -f docker-compose.scale.yml up -d
#
# ⚠️ 格式要求（与 .env.example 同）：docker compose 的 env_file 解析比
#    python-dotenv 严格得多，必须写成 `KEY=value`，等号前后不留空白、
#    行尾不留空格，否则 `up -d` 直接报 invalid env file。
# ⚠️ 本文件含数据库/Redis 口令与共享 token，不入库、不进镜像、600 权限。

# ============ 镜像版本（与主控机同一批交付，见 docs/deploy-scale.md §5） ============
# 与主控机 .env 的 IMAGE_TAG 同值：任务代码由消费它的 worker 执行，
# 两机 tag 不一致 = 同一队列混跑两个版本的行为面。
IMAGE_TAG=latest
# executor 镜像 tag（docker/Dockerfile.executor，同批交付同 tag）
EXECUTOR_IMAGE_TAG=latest

# ============ 中心数据面（主控机；评测机不自建 DB/Redis） ============
# 主控机 PostgreSQL 连接串（评测机只读消费任务，写结果同样经此连接）：
DATABASE_URL=postgresql://<user>:<password>@<主控机IP>:5432/<database>
# 主控机 Redis（celery broker + 结果后端 + team 配额，评测机 worker 经它
# 与主控机 worker 同队列竞争消费）。主控机侧发布与鉴权要求见
# docs/deploy-scale.md §4.3：必须 requirepass + 防火墙限源，绝不能裸奔。
REDIS_URL=redis://:<Redis口令>@<主控机IP>:6379/0

# JWT 签名密钥（ARCH-0-2）：worker 启动校验必填，与主控机 .env 的
# AUTH_JWT_SECRET 同值（轮换时两机同步改、同步重启）。
AUTH_JWT_SECRET=

# ============ 节点标识与队列（ARCH-2-1 / ARCH-3-1） ============
# 本评测机节点名：celery 节点名显示为 celery@<节点名>，多机时区分任务被
# 哪台接走（拔机演练、日志排障用）。每台评测机取唯一值，如 eval-node-2。
EVAL_NODE_NAME=ai-evo-eval-node
# 只消费 eval 队列已由 docker-compose.scale.yml 固定（CELERY_WORKER_QUEUES=eval，
# 配置面 -Q 等价物），ingest/maint 车道留在主控机，无需在此配置。

# ============ 共享存储边界（设计 3-1 的核心约定） ============
# uploads 根 = 共享存储挂载源（必填，无缺省——缺省本地目录会让脚本库/
# 数据集缓存与主控机分叉）。脚本库 pre_judge_scripts/、数据集缓存
# datasets/ hub_files/ media/、任务归档 archives/ 全在共享面，与主控机
# 同一份。NFS 建议 sec=sys 且两端 uid 一致（平台固定 10002）；
# 挂载选项与属主要求见 docs/deploy-scale.md §3。
UPLOADS_VOLUME=/mnt/ai-evo-uploads
# script_runs 工作区 = 本机盘（热 IO 不走网络，经嵌套挂载遮蔽共享面）。
# 缺省 bind ./script_runs；部署目录本身在 NFS 上时必须切命名卷：
# SCRIPT_RUNS_VOLUME=script_runs（docker 卷根在本机盘）。该命名卷形态必须
# 同时配 SANDBOX_WORKSPACE_HOST_ROOT（见下方沙箱面段落）。
#SCRIPT_RUNS_VOLUME=./script_runs
# 本机日志卷（缺省 bind ./logs）
#LOGS_VOLUME=./logs

# ============ 沙箱面（与主控机 ARCH-1-3 同一套开关） ============
# 评测机必须启用（worker-eval 的前处理脚本执行面是本机成对 executor）：
COMPOSE_PROFILES=sandbox
# worker↔executor 共享 token，与主控机 .env 的 EXECUTOR_TOKEN 同值
# （openssl rand -hex 32 生成；留空 = executor fail-closed 拒绝全部请求）
EXECUTOR_TOKEN=
# worker 侧 HTTP 驱动访问本机成对 executor（compose 内网服务名，固定值）
EXECUTOR_URL=http://executor:8300
# 本机 docker 组 gid——每台评测机独立核对：stat -c %g /var/run/docker.sock
DOCKER_GROUP_GID=999
# 沙箱 bind 源宿主根：docker daemon 按宿主路径解析 -v 源，SCRIPT_RUNS_VOLUME
# 切命名卷（script_runs）时必填其 docker 卷根；bind 且路径一致时可留空
#（缺省 = 行为不变）。daemon 路径与容器路径不一致时不配会静默拿空工作区
#SANDBOX_WORKSPACE_HOST_ROOT=/var/lib/docker/volumes/script_runs/_data

# egress 出口代理镜像与策略文件（与主控机同款；docker/egress/ 目录须随
# docker-compose.scale.yml 一起同步到评测机部署目录）
#EGRESS_IMAGE=ubuntu/squid:latest
#EGRESS_WHITELIST_FILE=./docker/egress/whitelist.txt
#EGRESS_SQUID_CONF=./docker/egress/squid.conf

# 前处理脚本沙箱 runner 镜像（container 模式；评测机需预载，
# 见 docs/deploy-scale.md §5；tag 与主控机一致）
#SCRIPT_RUNNER_IMAGE=ai-evo-script-runner:latest
#SCRIPT_RUNNER_USER=10001:10001
# 前处理脚本执行模式（ARCH-1-4）：缺省 container（compose 插值缺省即合规态，
# 与主控机同款）。local 仅开发机显式 env、企业部署禁止（同边界风险见
# docs/build-pipeline.md 第九节）；过渡期止损回退：取消注释设 local 后
# docker compose up -d 重启生效。
#SCRIPT_EXEC_MODE=container

# ============ 外呼代理（灰度，缺省直出） ============
# 评测机 worker 模型测连/OSS 外呼走本机 egress 的灰度开关：留空 = 直出
# （与主控机既有行为一致）；收口设 http://egress:3128
#WORKER_EGRESS_PROXY=http://egress:3128
# 不走 proxy 的内网目标（评测机本地只有 executor/egress 两个服务名；
# 启用 proxy 后如需 HTTP 直达主控机，在此追加主控机地址）
#WORKER_NO_PROXY=localhost,127.0.0.1,::1,executor,egress

# ============ tmpfs 容量（与主控机同款，默认各 1g） ============
#TMPFS_TMP_SIZE=1g
#TMPFS_HOME_SIZE=1g

# ============ 自建在线构建参数（离线交付用不到，见 §5 说明） ============
#NODE_IMAGE=node:24-slim
#PY_IMAGE=python:3.12-slim
#PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
#NPM_REGISTRY=https://registry.npmmirror.com
