# AI 评测平台部署环境变量模板
#
# 使用方法：复制到部署目录下的 .env 并填入真实值。
#   cp .env.example .env && chmod 600 .env
#
# .env 不入库，由 CI 部署时读取（compose 的 env_file 与 ${IMAGE_TAG} 插值）。
#
# ⚠️ 格式要求：docker compose 的 env_file 解析比 python-dotenv 严格得多，
#    `KEY = value`（等号前有空格）、值里含未转义空格、行尾空格都会让
#    `docker compose up -d` 直接报 "invalid env file" 而启动失败。
#    必须写成 `KEY=value`，且不要给变量名/值留多余空白。

# ============ 镜像版本 ============
# 由 CI 在部署时自动写入当前 commit 短 sha，回滚即把这里改回旧 sha。
# 手工部署时可临时指定，例如 IMAGE_TAG=abc1234
IMAGE_TAG=latest

# ============ 数据库 ============
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>

# ============ Redis ============
# 指向 compose 网络内的 redis 服务，通常无需修改
REDIS_URL=redis://redis:6379/0

# ============ 登录鉴权 ============
# JWT 签名密钥（HS256，ARCH-0-2/设计决策 D6）：企业部署必填——留空时服务启动
# 直接失败（fail-fast，见 app/core/config.py validate_runtime_settings），
# 不再从 DATABASE_URL 派生（轮换 DB 口令不应作废全员登录态）。
# 生成随机密钥：openssl rand -hex 32
# 轮换：替换为新生成的值后 docker compose up -d 重启，全部已签发登录态即失效
# （用户需重新登录），建议低峰期执行并提前公告。
AUTH_JWT_SECRET=

# 派生回退开关（ARCH-0-2）：仅本地开发机使用——true 时允许 AUTH_JWT_SECRET
# 留空、由 DATABASE_URL 派生稳定密钥（启动日志会告警）。企业部署严禁开启。
#AUTH_JWT_ALLOW_DERIVED=false

# ============ 备份（scripts/backup.sh，部署机 crontab 注入） ============
# 备份输出根目录（相对部署目录）；DB 备份保留 14 天，补传区归档保留 14 天。
# crontab 落地与演练步骤见 docs/build-pipeline.md「备份与恢复」。
#BACKUP_DIR=./backups
#RETENTION_DAYS=14
#UPLOADS_RETENTION_DAYS=14

# ============ 数据同步（scripts/sync_database.py，手动运维用） ============
# 远程（数据源）与本地（被覆盖方）的 PostgreSQL 连接串；缺失时脚本直接报错退出，
# 不再从代码读取（W6-3：口令不落库）。
#REMOTE_DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
#LOCAL_DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:5432/<database>


# ============ anc-hub 插件（hub-plugin 服务，可选覆盖） ============
# 以下四项 compose 已带同机默认值（回环直连 hub 插件面 :8093、本插件 :9500、
# 宿主回环调 api :8100），仅当拓扑变化（如 hub 换端口/跨机部署）才需要在
# 服务器 .env 里覆盖。instance_id 全局唯一，不要与其他插件撞。
#AIEVO_HUB_ADDR=http://127.0.0.1:8093
#AIEVO_HUB_ADVERTISE_ADDR=http://127.0.0.1:9500
#AIEVO_API_BASE=http://127.0.0.1:8100

# ============ 沙箱面：executor 与 egress 出口（ARCH-1-3） ============
# 沙箱面整体由 compose profile 控制：.env 设 COMPOSE_PROFILES=sandbox 启用
# executor（沙箱执行服务）+ egress（squid 白名单出口代理）两个新服务与
# aievo-sandbox-egress 内网；不设 = 行为与原部署完全一致。
# 启用步骤、SCRIPT_NET_PROFILE 网络档位与该内网的对应关系：
# 见 docs/build-pipeline.md「十、沙箱面部署（ARCH-1-3）」。
#COMPOSE_PROFILES=sandbox

# worker↔executor 共享鉴权 token（设计 D6：走 .env 不入库）。留空 =
# executor fail-closed 拒绝全部沙箱请求（探活不受影响）。生成：
#   openssl rand -hex 32
EXECUTOR_TOKEN=

# worker 侧 HTTP 驱动（ARCH-1-2）访问 executor 的地址：启用沙箱面后设
# （compose 内网服务名）。留空 = http-executor 驱动不可用（SCRIPT_EXEC_MODE
# 选不到该通道，不影响其他模式）
#EXECUTOR_URL=http://executor:8300

# 沙箱 bind 源宿主根（SANDBOX_WORKSPACE_HOST_ROOT）：命名卷部署必填。
# docker daemon 按**宿主路径**解析沙箱 -v 挂载源，而 worker 视角的工作区
# 路径是 /app/uploads/script_runs/...；uploads 用 bind 且宿主/容器路径一致
# （默认 ./uploads:/app/uploads）时可留空；UPLOADS_VOLUME=uploads（群晖等
# 命名卷形态）时宿主不存在该路径——daemon 会静默新建空目录，沙箱空工作区、
# stdout/stderr 日志回不来。填写 uploads 命名卷在宿主的真实根：
#SANDBOX_WORKSPACE_HOST_ROOT=/volume1/docker/ai-evo/uploads-data

# 部署机 docker 组 gid——executor 非 root 访问 /var/run/docker.sock 的补充组。
# 必查必配（默认 999 只是 Debian 系常见值）：stat -c %g /var/run/docker.sock
#DOCKER_GROUP_GID=999

# executor 镜像 tag（镜像 docker/Dockerfile.executor，CI 接入构建前的手工
# 部署可 docker build -t ai-evo-executor:<tag> -f docker/Dockerfile.executor .）
#EXECUTOR_IMAGE_TAG=latest

# egress 代理镜像（默认 Canonical 官方 ubuntu/squid，内网镜像源可拉；
# 离线部署机需预载，换源/换 tag 在这里覆盖）
#EGRESS_IMAGE=ubuntu/squid:latest

# egress 域名白名单文件：默认挂仓库模板 docker/egress/whitelist.txt；
# 企业部署改为指向服务器上自己的清单（如 EGRESS_WHITELIST_FILE=./egress-whitelist.txt），
# 改清单后 docker compose restart egress 生效。策略本体 docker/egress/squid.conf
# 同理可用 EGRESS_SQUID_CONF 覆盖（默认拒绝 + 内网目的地址拒绝一般不动）。
#EGRESS_WHITELIST_FILE=./docker/egress/whitelist.txt
#EGRESS_SQUID_CONF=./docker/egress/squid.conf

# worker 服务端外呼（模型测连/OSS）走 egress 代理的灰度开关（ARCH-1-3）：
# 留空 = 不走 proxy（默认，与既有行为一致）；启用沙箱面且 egress 健康后设：
#WORKER_EGRESS_PROXY=http://egress:3128
# 不走 proxy 的内网目标（默认含 compose 服务名 + 回环）；追加企业内网域名/
# 私有 OSS 时覆盖整行。仅 WORKER_EGRESS_PROXY 非空时生效
#WORKER_NO_PROXY=localhost,127.0.0.1,::1,api,redis,postgres,executor,egress

# ============ DeepEval 平台网关接线（W16，待 D-6 技术决策后启用） ============
# D-6：f1518c1 revert 根因未确认（deepeval 接线是否被有意回退），技术决策前保持关闭。
# true  = deepeval 的 safety/agent 等指标判分经 PlatformLLMWrapper 走平台模型配置
#         （model_configs）出真实分；解析不到可用模型配置时结果明确标
#         metric_unavailable，不再伪装 score=0。
# false = 默认值，行为与未接线一致。
#DEEPEVAL_USE_PLATFORM_LLM=false
# 指定 deepeval 判分用的模型配置 ID（model_configs.id）；留空时自动选取最新的
# 启用中 evaluation 角色模型。仅 DEEPEVAL_USE_PLATFORM_LLM=true 时生效。
#DEEPEVAL_PLATFORM_MODEL_ID=

# ============ M1 门禁闭环：webhook SSRF 防护（QE1-3 投递通道接线） ============
# webhook URL 校验（app/services/webhook_url_guard.py）默认拒绝 localhost/私网/
# 链路本地目标（防 SSRF 打内网）。企业内网接收端场景（自托管部署常见）置
# true 显式放行内网目标，由部署者自行承担内网目标面。
#WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# ============ M2 终态校验器：http_assert 内网目标放行总闸（管理员） ============
# http_assert 校验器的出网同样默认仅公网目标（且不跟随重定向）。任务配置里
# 勾选「允许内网目标」仅是任务侧意向，需本总闸置 true 才真正放行——放行
# 内网目标的决定权在部署管理员而非任务创建者（与 webhook 同口径）。
#HTTP_ASSERT_ALLOW_PRIVATE_TARGETS=false
